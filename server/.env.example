# Server port (default 5001)
PORT=5001

# Frontend origin (for CORS). Local dev: localhost. Production: your live site.
FRONTEND_URL=http://localhost:5173
# Production example: https://aromatales.shop

# === Supabase ===
# From Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the SERVICE ROLE KEY here. It must stay on the server only - never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Optional: same project anon key (not required if you only use the service role on the server).
# SUPABASE_ANON_KEY=YOUR-ANON-KEY

# === Resend (transactional email) ===
# https://resend.com/api-keys
RESEND_API_KEY=re_xxx_your_api_key
# Verified sending domain. Until you verify a domain you can use Resend's sandbox sender.
RESEND_FROM_EMAIL=Aroma Tales <onboarding@resend.dev>
# Where order/contact notifications should land
ADMIN_EMAIL=info.aromatales@gmail.com
# After you verify aromatales.shop in Resend, prefer e.g. Aroma Tales <hello@aromatales.shop>
