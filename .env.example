# Frontend env (Vite). All keys must be prefixed with VITE_ to be exposed to the browser.

# Backend API URL. In dev, vite proxies /api to Express. On Vercel (this repo: SPA + api/index.js), keep /api
# so the browser always calls the same host (fixes www vs apex CORS issues).
# Only use an absolute URL if the API is on a different domain (e.g. https://api.example.com).
VITE_API_URL=/api

# Supabase (browser): Project Settings -> API. Use the anon/public key only — never the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
