# Frontend env (Vite). All keys must be prefixed with VITE_ to be exposed to the browser.

# Backend API URL. In dev, vite proxies /api to the Express server, so use /api.
# Production: absolute URL of your API origin (no trailing slash), e.g. https://api.aromatales.shop
VITE_API_URL=/api

# Supabase (browser): Project Settings -> API. Use the anon/public key only — never the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
